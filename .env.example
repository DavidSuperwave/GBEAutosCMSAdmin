DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/gbe_autos_cms
POSTGRES_POOL_MAX=3
POSTGRES_IDLE_TIMEOUT_MS=10000
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_MAX_LIFETIME_SECONDS=300
POSTGRES_APPLICATION_NAME=gbe-autos-cms-local
ADMIN_DASHBOARD_QUERY_CONCURRENCY=2
PAYLOAD_SECRET=replace-with-a-random-32-character-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
# Public website (GBE Autos) base URL — used for vehicle/page live previews (/cars/:slug)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
# Optional: external vehicle specs enrichment (only used on manual create, never on import)
RAPIDAPI_KEY=
RAPIDAPI_VEHICLE_SPECS_HOST=car-specs.p.rapidapi.com
AI_IMAGE_API_KEY=
# Optional: vehicle photo sourcing (CarsXE Vehicle Images API). Used by the
# in-vehicle image studio "Buscar fotos" feature. Server-side only.
CARSXE_API_KEY=
CARSXE_IMAGES_HOST=api.carsxe.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=replace-with-your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=GBE Autos CMS
SMTP_SECURE=false

# Supabase vehicle image sync. Use only server-side values; never commit real keys.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=vehicle-images
SUPABASE_STORAGE_PREFIX=vehicle_images
STORAGE_UPSERT=true
ZIP_PATH=./vehicle_images_full.zip
CSV_PATH=./inventory_with_images.csv
INVENTORY_TABLE=vehicles
INVENTORY_ID_COLUMN=source_id
CSV_ID_COLUMN=IDV
CSV_IMAGE_FILENAME_COLUMN=image_filename
CSV_IMAGE_PATH_COLUMN=image_path
INVENTORY_IMAGE_URL_COLUMN=image_url
INVENTORY_IMAGE_PATH_COLUMN=image_path
INVENTORY_IMAGE_FILENAME_COLUMN=image_filename
INVENTORY_IMAGE_STATUS_COLUMN=image_status
INVENTORY_IMAGE_STATUS_VALUE=uploaded
PUBLIC_URL_BASE=
DRY_RUN=true
UPLOAD_BATCH_CONCURRENCY=4
UPDATE_BATCH_CONCURRENCY=8
