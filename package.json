{
  "name": "gbe-autos-cms-admin",
  "version": "1.0.0",
  "description": "Payload CMS admin and API for GB Automotriz",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "audit:data-api": "node scripts/audit-supabase-data-api.mjs --require-locked",
    "check:admin-styles": "node scripts/check-admin-styles.mjs",
    "check:contracts": "node scripts/check-storefront-contract.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "cleanup:qa": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/cleanup-production-qa.ts",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation POSTGRES_POOL_MAX=2 payload migrate",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "test:e2e:production": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/production-e2e-smoke.ts",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/seed.ts",
    "seed:collections": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/seedCollections.ts",
    "stage:delivery-pack-media": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/stage-delivery-pack-media.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "sync:media-storage": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/sync-media-storage.ts",
    "sync:agency-links": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/sync-agency-links.ts",
    "sync:vehicle-images": "node scripts/sync-vehicle-images.mjs",
    "test": "node --import tsx --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit --incremental false",
    "verify:vehicle-images": "node scripts/sync-vehicle-images.mjs --verify-only",
    "upload:vehicle-images": "node scripts/sync-vehicle-images.mjs --upload-only --apply",
    "update:vehicle-image-urls": "node scripts/sync-vehicle-images.mjs --db-only --apply",
    "dry-run:vehicle-images": "node scripts/sync-vehicle-images.mjs --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1088.0",
    "@payloadcms/db-postgres": "^3.84.1",
    "@payloadcms/email-nodemailer": "^3.84.1",
    "@payloadcms/next": "^3.84.1",
    "@payloadcms/richtext-lexical": "^3.84.1",
    "@payloadcms/storage-s3": "3.85.1",
    "@payloadcms/ui": "^3.84.1",
    "@supabase/supabase-js": "^2.108.2",
    "adm-zip": "^0.5.17",
    "cross-env": "10.1.0",
    "csv-parse": "^7.0.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "^16.2.2",
    "payload": "^3.84.1",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "0.34.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.8",
    "@types/node": "24.12.3",
    "@types/pg": "^8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.49.0",
    "vite-tsconfig-paths": "6.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
