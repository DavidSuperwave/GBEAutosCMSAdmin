# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

/.idea/*
!/.idea/runConfigurations

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env

/media
/output/
/.agents/
/skills-lock.json

# local orchestration/runtime state (durable outputs belong under docs/)
/.fable-5/
/.oracle/

# machine-specific pointers emitted by the local Fable renderer
/docs/product/roadmaps/**/RUN_PATH.txt

# local vehicle image sync inputs/secrets
vehicle_images_full.zip
inventory_with_images.csv
*.service-role.env

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
